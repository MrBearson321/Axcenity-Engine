{
  "about": "Performance baselines for axcenity-bench-check (docs/benchmarks.md, \"Regression check\"). Numbers are milliseconds and only compare on the machine that recorded them. A project scene is a copy of that project from the projects folder, cooked; S10k is made by axcenity-test --make-s10k.",
  "machines": {
    "desktop-9950x3d": {
      "about": "AMD Ryzen 9 9950X3D (16 cores), 62 GB, AMD Radeon RX 9070 XT on Vulkan, Windows 11. Pinned to CPUs 0-15 (the V-cache CCD). Recorded at main 15965da with nothing else running; the dry-patch runs were added on the rendering-initiative branch (Phase 1), where the player benchmarks with vertical sync off. A full check on that branch matched every older baseline within 4%.",
      "commit": "15965da (dry-patch: rendering initiative, oak bark one-sided)",
      "results": {
        "dry-patch-test": {
          "frame_ms": 0.028
        },
        "dry-patch-ultra-1440p": {
          "assets_ms": 1558.673,
          "bound": "GPU-bound",
          "first_frame_ms": 281.753,
          "frame_ms": 11.043,
          "gpu_ms": 10.914,
          "low_1pct_fps": 76.4,
          "known": "Recorded after the owner's oaks' Bark materials were made one-sided (2026-11-11): about 0.6 ms faster than with double-sided bark, pictures the same. Copy the project again with --fresh after its assets change."
        },
        "farmhouse-player": {
          "assets_ms": 1579.117,
          "first_frame_ms": 211.72,
          "frame_ms": 5.399,
          "known": "Startup fixed by #65, #67 and #69 (first frame 4.35 s -> 0.21 s). Still open: the steady frame is about 0.6 ms above 300bbb5's 4.77 ms. See docs/benchmarks.md, 'Before and after the roadmap'."
        },
        "farmhouse-test": {
          "frame_ms": 0.091
        },
        "s10k-editor-play": {
          "frame_ms": 3.44
        },
        "s10k-player": {
