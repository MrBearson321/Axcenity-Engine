--- The project's data tables (`assets/data/*.data.json`, made in the Data Table tab), from `game:GetService("DataService")`. Scripts read them; they can't change them.
declare extern type DataService with
	--- The table named `name`: `"weapons"` is `assets/data/weapons.data.json`. A table that isn't there, or can't be read, is an error saying why.
	function GetTable(self, name: string): DataTable
end

--- A data table, read-only. Each call reads the version in use now, so an edit made during Play is what the next call sees.
declare extern type DataTable with
	--- The row with this key, or nil if there's none.
	function Get(self, key: string): DataRow?
	--- Every row, by its key: `for key, row in weapons:GetAll() do`. A new table each call.
	function GetAll(self): { [string]: DataRow }
	--- Every row's key, in the table's order. A new list each call.
	function Keys(self): { string }
end

--- One row of a data table, read by column name: `row.Damage`. Numbers, strings, booleans, Vector3s and Color3s are what they say; an enum is its option's name, an asset its path, and a reference the row it names (nil for none). `for column, value in row do` goes through its columns. Changing it is an error: tables are read-only in scripts.
declare extern type DataRow with
	[string]: any
end

--- What loads first on the player's side, from `game:GetService("ReplicatedFirst")`.
declare extern type ReplicatedFirst with
	--- Says the game is ready: the loading screen goes once it has been up for its minimum time. Only waited for when the project's loading screen is set to wait for a script. LocalScripts only. LocalScripts only.
	function RemoveDefaultLoadingScreen(self): ()
end

--- Moves properties smoothly to goals over time, from `game:GetService("TweenService")`.
declare extern type TweenService with
	--- A Tween that moves each property in `goals` (a table such as `{Position = Vector3.new(0, 5, 0)}`) of `instance` from where it is to its goal, as `tweenInfo` says. Numbers, Vector3s, Color3s, UDim2s and booleans (which switch at the end) can be tweened. Call `Play` to start it.
	function Create(self, instance: Instance, tweenInfo: TweenInfo, goals: { [string]: any }): Tween
end

--- Tags on Instances, from `game:GetService("CollectionService")`. An Instance counts as tagged while it is in the game. Tags are saved with the world, in prefabs and in save slots, and copied by `Clone`; the editor's Tags panel lists them.
declare extern type CollectionService with
	--- Gives `instance` the tag `tag`. Adding a tag it has does nothing.
	function AddTag(self, instance: Instance, tag: string): ()
	--- Takes the tag `tag` off `instance`.
	function RemoveTag(self, instance: Instance, tag: string): ()
	--- Whether `instance` has the tag `tag`.
	function HasTag(self, instance: Instance, tag: string): boolean
	--- The tags of `instance`, in the order they were added.
	function GetTags(self, instance: Instance): {string}
	--- Every Instance in the game with the tag `tag`, parents before their children.
	function GetTagged(self, tag: string): {Instance}
	--- Every tag an Instance in the game has, sorted.
	function GetAllTags(self): {string}
	--- An event that fires with an Instance when it gets the tag `tag` while in the game, or joins the game with it (such as a tagged clone put in the Workspace).
	function GetInstanceAddedSignal(self, tag: string): Signal
	--- An event that fires with an Instance when it loses the tag `tag`, or leaves the game with it (taken out, or destroyed).
	function GetInstanceRemovedSignal(self, tag: string): Signal
end

--- Save slots, player data, settings and checkpoints, from `game:GetService("SaveService")`. Slots are files in the player's data for this game, never in the project, so saving during Play doesn't change the project. Both sides share the same data.
declare extern type SaveService with
	--- Writes save slot `slot` (1 to 999): the player data, the world state (every part and model in the Workspace, and Lighting; not scripts or ScreenGuis), the active checkpoint and the settings. Replaces what the slot held.
	function SaveSlot(self, slot: number): ()
	--- Puts the game back as slot `slot` was saved: player data, world state, the active checkpoint and settings. Parts and models still in the world keep being the same Instances. A slot that doesn't exist, or can't be read, is an error and changes nothing.
	function LoadSlot(self, slot: number): ()
	--- True if slot `slot` has been saved.
	function HasSlot(self, slot: number): boolean
	--- Keeps `value` for the player under `name`, such as `SaveService:SetPlayerData("Coins", 10)`: a boolean, number, string, Vector3, Vector2, Color3, UDim2 or EnumItem. nil removes it. Saved in slots and captured at checkpoints.
	function SetPlayerData(self, name: string, value: any): ()
	--- The player data kept under `name`, or nil.
	function GetPlayerData(self, name: string): any
	--- Keeps a game setting under `name`, such as `SaveService:SetSetting("Volume", 0.5)`, with the same values as SetPlayerData. Saved in slots, but not captured at checkpoints. The `UI/` names are the game UI settings (see GuiService), and `Audio/MasterVolume` is `UserGameSettings.MasterVolume`.
	function SetSetting(self, name: string, value: any): ()
	--- The setting kept under `name`, or nil.
	function GetSetting(self, name: string): any
	--- Makes `checkpoint` the active Checkpoint, and captures the player data and world state now, for RestoreCheckpoint.
	function SetCheckpoint(self, checkpoint: Checkpoint): ()
	--- The active Checkpoint, or nil.
	function GetCheckpoint(self): Checkpoint?
	--- Puts back the player data and world state captured at the active checkpoint, and stands the player character (the one whose controller owns the camera) at its Position. An error if no checkpoint is active.
	function RestoreCheckpoint(self): ()
end

--- The game's levels, from `game:GetService("LevelService")`: `world.json` is the start level, and each other level is `levels/<name>.world.json`. A level is its Workspace; ReplicatedStorage, Players, Lighting, StarterPlayer and Teams stay the same from level to level. Both sides share it.
declare extern type LevelService with
	--- The name of the level in the Workspace now: the start level until LoadLevel loads another (in the editor's Play, the open level).
	CurrentLevel: string
	--- Fires with the level's name once LoadLevel (or LoadSlot, for a slot saved in another level) has put it in the Workspace: `function(name) ... end`. Connect again to things in the new level here.
	LevelLoaded: Signal
	--- Puts the level `name` in place of the Workspace, such as `LevelService:LoadLevel("Castle", "Gate")`. The Workspace's ScreenGuis and the players' characters stay; everything else in it is replaced, and the levels added with AddLevel go. Characters stand on the Instance called `spawnName` in the new level, or on one of their SpawnLocations. The loading screen shows, and LevelLoaded fires once it's in.
	function LoadLevel(self, name: string, spawnName: string?): ()
	--- Copies the level `name` into a new Model of that name in the Workspace, beside the current level, and returns the Model. An error if it's added already.
	function AddLevel(self, name: string): Model
	--- Takes the level `name`, added with AddLevel, out of the Workspace. An error if it isn't added.
	function RemoveLevel(self, name: string): ()
end

--- Hosting and joining games, from `game:GetService("NetworkService")`, so a menu can do them. Players who join appear in `Players` on every device (the worlds aren't shared yet). Both sides have it; in the editor's Play, Host and Join fail and FindLanGames finds nothing.
declare extern type NetworkService with
	--- Fires with why when hosting or joining fails, a join is refused (such as a version mismatch, a wrong password or a full game) or the connection is lost: `function(reason) ... end`.
	ConnectionFailed: Signal
	--- Hosts the game on this device on UDP `port` (47800 if left out), for at most `Players.MaxPlayers` players; with a `password`, only players who give it can join. ConnectionFailed fires if the port is taken.
	function Host(self, port: number?, password: string?): ()
	--- Joins the game hosted at `address`, such as `NetworkService:Join("192.168.1.20:47800")`, with its `password` if it has one. The player on this device may be renamed (a second `Player` is `Player2`). ConnectionFailed fires with why if it fails or is refused.
	function Join(self, address: string, password: string?): ()
	--- Asks the local network for hosts of this game, waits about a second (it pauses the script), and returns what answered: `{ Name, Version, Address, Players, MaxPlayers, HasPassword }` each, `Address` ready for Join.
	function FindLanGames(self): { { Name: string, Version: string, Address: string, Players: number, MaxPlayers: number, HasPassword: boolean } }
	--- Leaves the game joined, or stops hosting; the other players leave `Players`.
	function Disconnect(self): ()
end

--- The language UI text shows, from `game:GetService("LocalizationService")`. A TextLabel or TextButton with a `TextKey` shows that key's value from the project's string table (`strings.json`, edited in the UI Designer's Strings tab) in `Language`, or its own Text when there's none. Both sides share it.
declare extern type LocalizationService with
	--- The active language, such as `"English"`: one of `Languages`, the first when the game starts. Setting it changes every bound label and button; a language the table doesn't have is an error and changes nothing.
	Language: string
	--- The string table's languages, in order. Read only.
	Languages: { string }
	--- `key`'s value in the active language, or nil when the string table has none.
	function GetString(self, key: string): string?
end

--- The player's game UI settings, from `game:GetService("GuiService")`, for a settings menu. They change every HUD and menu (and the UI Designer's artboard) and never the 3D world, and they're separate from the editor's own appearance. Both sides share them, and save slots keep them (as the settings `UI/TextScale`, `UI/HighContrast` and `UI/ReducedMotion`).
declare extern type GuiService with
	--- How much bigger UI text is drawn than it's authored, from 0.5 to 3; 1 is as authored. Text with TextScaled on still fits its box. Anything else is an error and changes nothing.
	TextScale: number
	--- If true, UI text is drawn black or white (whichever is nearer its colour) and see-through backgrounds are drawn solid.
	HighContrast: boolean
	--- If true, UI motion that's only for looks happens at once: CSS transitions, tweens of UI elements, and the Animations and AnimationTracks playing on them jump to where they end (a looping one holds its first frame). Events such as Completed and Stopped still fire.
	ReducedMotion: boolean
end

--- This computer's graphics settings, from `game:GetService("UserGameSettings")`, for a settings menu. `GraphicsQuality` picks a preset, and each other field overrides one of its values; reading a field gives the value chosen (its override, or the preset's), and setting it to nil goes back to the preset's. Changing the preset keeps the overrides. Saved on this computer by the player (never in the game); in the editor's Play they start from the editor's Graphics settings and are put back at Stop. The GPU may draw less than was chosen: the player's log and the editor's Settings say why. LocalScripts only.
declare extern type UserGameSettings with
	--- The preset: Low, Medium, High or Ultra, or Automatic (High, or Low on a computer without a graphics card).
	GraphicsQuality: EnumGraphicsQuality
	--- The sun's shadow map: Off, Low (1024² × 2 cascades), Medium (2048² × 2), High (2048² × 3) or Ultra (4096² × 4), and how many spot lights cast shadows (none up to Low, then 2, 4, 8) and point lights (none up to Low, then 1, 2, 4).
	ShadowQuality: EnumShadowQuality
	--- The farthest shadows reach, in studs: a ceiling on `Lighting.ShadowDistance`.
	ShadowDistance: number
	--- False turns bloom and tone mapping off, whatever Lighting asks for.
	PostProcessing: boolean
	--- The scene's size as a fraction of the window's, from 0.5 to 2 (kept within that). The UI is always drawn at the window's size.
	RenderScale: number
	--- How sharp surface textures are: Full, Half or Quarter of their width and height.
	TextureQuality: EnumTextureQuality
	--- How edges are smoothed: Off, FXAA, MSAA2 or MSAA4.
	AntiAliasing: EnumAntiAliasing
	--- How corners and creases darken their ambient light: Off, Low or High.
	AmbientOcclusion: EnumAmbientOcclusion
	--- How the sky is reflected and lights surfaces: Low works its gradient out per pixel (no sky image), Medium, High and Ultra bake it into a 64², 128² or 256² cubemap.
	ReflectionQuality: EnumReflectionQuality
	--- Short shadows found on screen for the small gaps the shadow maps miss, such as under a part resting on the floor. On at High and Ultra.
	ContactShadows: boolean
	--- Light probe volumes traced again a few probes each frame, so their bounced light follows a moving sun or changing lamps. Off at every preset, and off on a GPU without compute shaders.
	RealtimeGI: boolean
	--- An Atmosphere's fog lit by the sun with its shadows (sun shafts) and by lamps. On at Ultra, and off on a GPU without compute shaders.
	VolumetricFog: boolean
	--- A multiplier on everything the game plays, from 0 (silent) to 1 (as mixed, the default). Unlike the graphics settings it's the game's: save slots keep it (as the SaveService setting `Audio/MasterVolume`), and the default audio settings UI has a slider for it.
	MasterVolume: number
	--- How Lighting's Clouds are drawn: Low as a flat sheet, Medium, High and Ultra looked through in 16, 32 or 64 steps (High and Ultra with fine detail and light traced toward the sun). Every quality casts the same shadows.
	CloudQuality: EnumCloudQuality
end

--- Properties moving to goals, made by `TweenService:Create`. Each frame it sets them, so their change events fire; a newer tween on the same property of the same Instance cancels it.
declare extern type Tween with
	--- Where it is: Begin, Delayed, Playing, Paused, Completed or Cancelled (read-only).
	PlaybackState: EnumPlaybackState
	--- Fires when it reaches its goals, or is cancelled, with how it ended: `function(playbackState) ... end`.
	Completed: Signal
	--- The Instance it moves (read-only).
	Instance: Instance
	--- How it plays (read-only).
	TweenInfo: TweenInfo
	--- Starts it from where the properties are now (after its DelayTime), or carries on after Pause.
	function Play(self): ()
	--- Holds it where it is; Play carries on from there.
	function Pause(self): ()
	--- Stops it where it is, and fires Completed with `Enum.PlaybackState.Cancelled`. Playing it again starts over from there.
	function Cancel(self): ()
end

--- How a tween plays, from `TweenInfo.new`. Read-only.
declare extern type TweenInfo with
	--- Seconds to reach the goals.
	Time: number
	--- The shape of the motion: Linear, or one of the clip key easings (Sine, Quad, Cubic, Back, Bounce, Elastic).
	EasingStyle: EnumEasingStyle
	--- Which end of the motion is eased: In (the start), Out (the end) or InOut (both).
	EasingDirection: EnumEasingDirection
	--- How many more times it plays after the first; -1 repeats forever.
	RepeatCount: number
	--- Whether each play goes back to the start after reaching the goals.
	Reverses: boolean
	--- Seconds to wait after Play before it starts.
	DelayTime: number
end

--- One input, as `UserInputService`'s events and `ContextActionService`'s actions get it.
declare extern type InputObject with
	--- Which key or controller button, such as `Enum.KeyCode.W` or `Enum.KeyCode.ButtonA` (`Thumbstick1` for the left stick), or `Unknown` for the mouse and touches.
	KeyCode: EnumKeyCode
	--- What it came from: `Keyboard`, `MouseButton1` to `MouseButton3`, `MouseMovement`, `MouseWheel`, `Touch`, or a controller (`Gamepad1` to `Gamepad4`).
	UserInputType: EnumUserInputType
	--- `Begin` when it went down, `Change` when it moved, `End` when it came up.
	UserInputState: EnumUserInputState
	--- Where the mouse or finger is, in pixels from the window's top left (Z is the wheel's notches), or a stick's position (-1 to 1, up positive).
	Position: Vector3
	--- How far it moved: the mouse in pixels, right and down positive, or a stick.
	Delta: Vector3
end

--- Where `workspace:Raycast` (or a shape cast) first met a collider, or nil when it missed.
declare extern type RaycastResult with
	--- The Part, MeshPart or Terrain the ray hit.
	Instance: Instance
	--- The point of contact, in studs.
	Position: Vector3
	--- The surface direction at the hit, pointing out.
	Normal: Vector3
	--- How far along the ray the hit is, in studs.
	Distance: number
end

--- A half-line from `Origin` along `Direction`, from `Camera:ScreenPointToRay`.
declare extern type Ray with
	--- Where it starts.
	Origin: Vector3
	--- Which way it goes, one stud long. Multiply it for `workspace:Raycast`: `workspace:Raycast(ray.Origin, ray.Direction * 500)`.
	Direction: Vector3
	--- The same ray: its Direction is already one stud long.
	Unit: Ray
end

--- The mouse in the world, from `Players.LocalPlayer:GetMouse()`. LocalScripts only.
declare extern type Mouse with
	--- Pixels from the view's left edge.
	X: number
	--- Pixels from the view's top edge.
	Y: number
	--- The ray from the camera through the mouse (`CurrentCamera:ScreenPointToRay`).
	UnitRay: Ray
	--- The part under the mouse: the first collider along UnitRay within 1000 studs, or nil.
	Target: Instance?
	--- Where UnitRay first meets a collider, or the point 1000 studs along it.
	Hit: CFrame
end

