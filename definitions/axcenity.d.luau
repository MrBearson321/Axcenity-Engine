--- Inside a Part, MeshPart, Model, ScreenGui or UI element: plays animation on its parent while the game runs: its state machine, if it has one, and the AnimationTracks loaded with LoadAnimation.
declare extern type Animator extends Instance with
	--- The state machine file it plays on its parent, inside the project folder, such as "assets/animations/hero/hero.statemachine.json". Empty plays only the AnimationTracks loaded on it. The Animator tab makes and edits them.
	StateMachine: string
	--- If false, everything it animates holds still: the animator stops moving on.
	Enabled: boolean
	--- Plays everything this many times as fast (1 is normal, 0 pauses).
	Speed: number
	--- The name of the state playing (read-only; use `Play` to change it). Empty until the animator first runs.
	CurrentState: string
	--- Fires when the animator moves to another state. The handler gets the new state's name, then the old one's: `function(state, previous) ... end`.
	StateChanged: Signal
	--- Fires when a playing clip passes one of its animation events. The handler gets the event's name.
	AnimationEvent: Signal
	[string]: any
	--- Sets a Bool parameter, such as `IsGrounded`: something that stays true or false until it's changed.
	function SetBool(self, name: string, value: boolean): ()
	--- A Bool parameter's value.
	function GetBool(self, name: string): boolean
	--- Sets a Number parameter, such as `Speed`: a value that changes gradually, for conditions and blend trees.
	function SetNumber(self, name: string, value: number): ()
	--- A Number parameter's value.
	function GetNumber(self, name: string): number
	--- Sets a Trigger parameter, such as `Jump`: a one-time request, used up by the transition it starts.
	function SetTrigger(self, name: string): ()
	--- Clears a Trigger that no transition has used yet.
	function ResetTrigger(self, name: string): ()
	--- Switches to the state named `state`, from its start, blending from the pose now over `blend` seconds (0.25 if left out; 0 snaps).
	function Play(self, state: string, blend: number?): ()
	--- Loads `animation` (an Animation, whose Clip names the clip) on this Animator and returns an AnimationTrack to play, stop and blend over the state machine.
	function LoadAnimation(self, animation: Animation): AnimationTrack
	--- The AnimationTracks loaded on this Animator that are playing now.
	function GetPlayingAnimationTracks(self): {AnimationTrack}
end

--- Points at a clip (`*.anim.json`). Load it with `animator:LoadAnimation(animation)` to play it, or tick AutoPlay to play it when the game starts.
declare extern type Animation extends Instance with
	--- The clip file inside the project folder, such as "assets/animations/Door/Open.anim.json".
	Clip: string
	--- If true, the Animator on the same parent plays it by itself when the game starts.
	AutoPlay: boolean
	--- If false, playback pauses at its current time; set true to continue.
	Enabled: boolean
	--- Plays the clip this many times as fast (1 is normal, 0 pauses).
	Speed: number
	--- If true, playback repeats instead of firing Completed at the end.
	Looped: boolean
	--- Fires when `animation:Play()` reaches the end of a clip that doesn't loop. The handler gets no arguments.
	Completed: Signal
	--- Fires when `animation:Play()` passes one of the clip's events. The handler gets the event's name.
	AnimationEvent: Signal
	[string]: any
	--- Plays this Animation's clip from the start, through the Animator on the same parent. `animator:LoadAnimation(animation)` is the newer way, with fades and weights.
	function Play(self): ()
	--- Stops playback and goes back to the start of the clip.
	function Stop(self): ()
	--- Pauses at the current time. Resume continues from there.
	function Pause(self): ()
	--- Continues after Pause.
	function Resume(self): ()
end

--- One Animation loaded on an Animator, from `animator:LoadAnimation(animation)`: play, stop and blend it over the state machine.
declare extern type AnimationTrack extends Instance with
	--- True from Play until Stop, or until a clip that doesn't loop ends (read-only).
	IsPlaying: boolean
	--- The clip's length in seconds (read-only; 0 until the clip has been read, a frame after LoadAnimation).
	Length: number
	--- Whether it plays again from the start when it ends. Starts as the clip's own.
	Looped: boolean
	--- How fast it plays (read-only; use AdjustSpeed).
	Speed: number
	--- Seconds into the clip. Set it to jump there.
	TimePosition: number
	--- How much it counts now, from 0 to 1, while fading (read-only).
	WeightCurrent: number
	--- The weight it's fading to (read-only; use AdjustWeight).
	WeightTarget: number
	--- The Animation it was loaded from (read-only).
	Animation: Animation
	--- Fires when the track has stopped: after Stop's fade, or at the end of a clip that doesn't loop.
	Stopped: Signal
	--- Fires each time the track passes one of the clip's events. The handler gets the event's name; GetMarkerReachedSignal hears one name.
	KeyframeReached: Signal
	[string]: any
	--- Plays the clip from its start, fading in over `fadeTime` seconds (0.1 if left out) to `weight` (1), at `speed` (1). Where it and what plays under it animate the same thing, the track started last wins.
	function Play(self, fadeTime: number?, weight: number?, speed: number?): ()
	--- Stops it, fading out over `fadeTime` seconds (0.1 if left out). Stopped fires once it has faded out.
	function Stop(self, fadeTime: number?): ()
	--- Plays it this many times as fast from now (1 is normal, 0 holds, negative plays backwards).
	function AdjustSpeed(self, speed: number?): ()
	--- Fades how much it counts to `weight` (0 to 1) over `fadeTime` seconds (0.1 if left out).
	function AdjustWeight(self, weight: number?, fadeTime: number?): ()
	--- An event that fires each time the track passes the clip's event named `name`. The handler gets the name.
	function GetMarkerReachedSignal(self, name: string): Signal
end

