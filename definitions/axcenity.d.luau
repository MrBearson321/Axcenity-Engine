-- Instances -----------------------------------------------------------------

--- An event, such as `part.Touched`. Connect a function to run it every time the event fires.
declare extern type Signal with
	--- Runs `callback` every time the event fires, each time as its own task (so it may `task.wait`). Returns a Connection for stopping it.
	function Connect(self, callback: (...any) -> ()): Connection
end

--- A function connected to an event, returned by `Connect`.
declare extern type Connection with
	--- True until `Disconnect` is called (or the Instance is destroyed).
	Connected: boolean
	--- Stops the function from running when the event fires again. Calling it twice is harmless.
	function Disconnect(self): ()
end

--- Anything in the game tree. Every class below is a kind of Instance.
declare extern type Instance with
	--- The Instance's name. Children can be found by name: `workspace.Block`.
	Name: string
	--- The Instance's class, such as `"Part"`. Read-only.
	ClassName: string
	--- The Instance this one is inside, or nil. Setting it moves the Instance.
	Parent: Instance?
	--- Fires when a property (or `Name` or `Parent`) gets a different value, whether a script, physics or the editor changed it. The handler gets the property's name: `function(property) ... end`.
	Changed: Signal
	--- Fires when an Instance is put inside this one. The handler gets the child.
	ChildAdded: Signal
	--- Fires when an Instance is taken out of this one. The handler gets the child.
	ChildRemoved: Signal
	[string]: any
	--- The first child with this name, or nil. With `recursive`, searches every descendant.
	function FindFirstChild(self, name: string, recursive: boolean?): Instance?
	--- An event that fires when this one property (or `Name` or `Parent`) gets a different value. The handler gets nothing: read the property to see its new value.
	function GetPropertyChangedSignal(self, property: string): Signal
end

--- The root of the game, called `game` in scripts.
declare extern type DataModel extends Instance with
	--- The service that holds the 3D world. Parts inside it are drawn.
	Workspace: Workspace
	--- The service with a Player for everyone in the game.
	Players: Players
	--- The service for the world's lighting. It sets sun shadows, the sky colors that metal parts reflect, and post-processing (exposure, tone mapping and bloom).
	Lighting: Lighting
	--- The service for things Scripts and LocalScripts share, such as RemoteEvents and ModuleScripts.
	ReplicatedStorage: ReplicatedStorage
	--- The service that holds server scripts (`scripts/*.server.lua`).
	ServerScriptService: ServerScriptService
	--- The service with what each player starts with, such as StarterPlayerScripts.
	StarterPlayer: StarterPlayer
	--- The player's keyboard (same as `game:GetService("UserInputService")`). LocalScripts only.
	UserInputService: UserInputService
	--- The game's frame loop, with `Heartbeat` (same as `game:GetService("RunService")`).
	RunService: RunService
	--- Moves properties smoothly to goals (same as `game:GetService("TweenService")`).
	TweenService: TweenService
	--- Save slots, player data, settings and checkpoints (same as `game:GetService("SaveService")`).
	SaveService: SaveService
	--- What loads first on the player's side, with `RemoveDefaultLoadingScreen` (same as `game:GetService("ReplicatedFirst")`).
	ReplicatedFirst: ReplicatedFirst
	[string]: any
	--- The service with this class name, such as `"Players"`, `"ReplicatedFirst"`, `"RunService"`, `"SaveService"`, `"TweenService"` or `"UserInputService"`.
	function GetService(self, className: string): Instance
end

--- The service that holds the 3D world. Parts inside it are drawn.
declare extern type Workspace extends Instance with
	--- The wind everywhere, in studs a second. It carries particles from emitters with WindAffectsDrag and pushes unanchored parts with WindAffected.
	GlobalWind: Vector3
	--- The camera the player sees through. LocalScripts only.
	CurrentCamera: Camera
	[string]: any
	--- The first collider along `direction` from `origin`, or nil. The direction's length is how far the ray reaches. Hits sensors (`CanCollide` off) as well as solid parts and terrain. The result has Instance, Position, Normal and Distance.
	function Raycast(self, origin: Vector3, direction: Vector3): RaycastResult?
end

--- The service with a Player for everyone in the game.
declare extern type Players extends Instance with
	--- The player on this device. LocalScripts only.
	LocalPlayer: Player
	[string]: any
end

--- The service for the world's lighting. It sets sun shadows, the sky colors that metal parts reflect, and post-processing (exposure, tone mapping and bloom).
declare extern type Lighting extends Instance with
	--- If false, the sun casts no shadows. Turn this off on low-end machines.
	ShadowsEnabled: boolean
	--- How far from the camera sun shadows reach, in studs. Shorter distances give sharper shadows.
	ShadowDistance: number
	--- How soft shadow edges are, from 0 (crisp) to 1 (very soft). Edges stay sharp where a part touches what it shades and soften further away, like real shadows.
	ShadowSoftness: number
	--- The sky's color straight up.
	SkyTopColor: Color3
	--- The sky's color at the horizon.
	SkyHorizonColor: Color3
	--- The color of the ground below the horizon, as the sky and reflections see it.
	GroundColor: Color3
	--- How strongly the sky lights and is reflected by parts. 0 turns it off.
	EnvironmentIntensity: number
	--- If false, the scene is drawn with no tone mapping or bloom.
	PostProcessingEnabled: boolean
	--- Brightens or darkens the whole image before tone mapping. 1 is neutral.
	Exposure: number
	--- The curve that turns bright light into colors a screen can show. Classic (worlds made before it existed) keeps colors under 0.6 as they are and flattens brighter ones; Neutral (new worlds) keeps colors close to how they were picked and rolls highlights off without changing their hue; Filmic adds contrast for a cinematic look.
	ToneMapping: EnumToneMapping | "Classic" | "Neutral" | "Filmic"
	--- If false, bright parts don't glow.
	BloomEnabled: boolean
	--- How strong the glow around bright parts is.
	BloomIntensity: number
	--- How bright a pixel must be before it glows.
	BloomThreshold: number
	[string]: any
end

